# Materials of the GATE 10 model of the Siemens MAMMOMAT Revelation with the L2 v2 phantom.
# GATE material-database format (as GateMaterials.db), read by:
#   - revelation_gate.py  -> sim.volume_manager.add_material_database(...), i.e. what Geant4 simulates;
#   - materials.py        -> compositions for the analytic parts (primary projector, grid, detector),
# so this file is the single source of material data for the whole model.
#
# Format rules (GATE parser): one header line "Name: d=<value> g/cm3 ; n=<components> ; state=<solid|liquid|gas>",
# followed by exactly n component lines, "+el: name=<element> ; f=<mass fraction>" or "+mat: name=<material> ; f=..."
# No comments or blank lines inside a material block. Elements are Geant4 NIST elements, given by symbol.
# Mass fractions of each material sum to 1. Check the file after editing with:  python materials.py
#
# Geant4 NIST materials are used by name and are not listed here: G4_PLEXIGLASS (PMMA: container walls and plate,
# 1.19 g/cm3), G4_POLYCARBONATE (paddle [A]), G4_AIR (world), G4_Pb (grid lamellae [A], analytic only).
# Sources: [M] derived in this project (L2_container_v2/MATERIALS.md, REPORT §10); [A] assumption.

# Elements: GATE takes them from the Geant4 NIST database by symbol; these definitions are only a fallback.
[Elements]
H: S= H ; Z= 1. ; A= 1.008 g/mole
C: S= C ; Z= 6. ; A= 12.011 g/mole
N: S= N ; Z= 7. ; A= 14.007 g/mole
O: S= O ; Z= 8. ; A= 15.999 g/mole
P: S= P ; Z= 15. ; A= 30.974 g/mole
Ca: S= Ca ; Z= 20. ; A= 40.078 g/mole
Se: S= Se ; Z= 34. ; A= 78.971 g/mole
I: S= I ; Z= 53. ; A= 126.904 g/mole

[Materials]

# ---- suggested v2 background (option PA12_MCT, default) -----------------------------------------------------------------
# Spheres: PA12 (C12H23NO)n, 1.01 g/cm3, filled with 5.5 wt% CaCO3 (2.71 g/cm3). Density by the mixing rule, no voids [M].
# Laser-sintered PA12 is porous and takes up oil: replace the density (and composition) with measured values after
# oil saturation once the spheres are made.
PA12_CaCO3_5p5: d=1.046 g/cm3 ; n=5 ; state=solid
+el: name=C ; f=0.696867
+el: name=H ; f=0.111031
+el: name=O ; f=0.102997
+el: name=N ; f=0.067081
+el: name=Ca ; f=0.022024

# Liquid: MCT oil (caprylic/capric triglyceride, Ph. Eur.), approximated as C29H54O6, 0.945 g/cm3 [M].
MCT_oil: d=0.945 g/cm3 ; n=3 ; state=liquid
+el: name=C ; f=0.698391
+el: name=H ; f=0.109138
+el: name=O ; f=0.192471

# ---- current L2 background (option PMMA_paraffin) --------------------------------------------------------------------
# Spheres: PMMA (NIST composition C5H8O2), 1.19 g/cm3; kept as its own material so the density can be set to measured
# values without touching the PMMA of the container and plate.
PMMA_sphere: d=1.19 g/cm3 ; n=1 ; state=solid
+mat: name=G4_PLEXIGLASS ; f=1.0

# Liquid: liquid paraffin (n-alkane-like mineral oil), H 0.148 / C 0.852, 0.86 g/cm3 [A] (REPORT §6; European
# Pharmacopoeia liquid paraffin: relative density 0.827-0.890). Replace with the supplier's or a measured density.
paraffin_oil: d=0.86 g/cm3 ; n=2 ; state=liquid
+el: name=C ; f=0.852
+el: name=H ; f=0.148

# ---- tissue reference (option gland_adipose; a simulation target, not a buildable phantom) -----------------------------
# Glandular-tissue spheres in adipose tissue: the material pair whose residual under Siemens' W the redesign has to
# match (REPORT §10, r_tissue). Hammerstein et al. 1979 compositions as used by the REPORT model
# (investigation_0035_0037/scripts/model.py; REPORT [R6], from the secondary table of Rashid et al. 2021, primary not
# accessed; trace elements lumped into P); densities 1.04 / 0.93 g/cm3 (cited there from Boone) [M].
glandular_tissue: d=1.04 g/cm3 ; n=5 ; state=solid
+el: name=H ; f=0.102
+el: name=C ; f=0.184
+el: name=N ; f=0.032
+el: name=O ; f=0.677
+el: name=P ; f=0.005
adipose_tissue: d=0.93 g/cm3 ; n=5 ; state=liquid
+el: name=H ; f=0.112
+el: name=C ; f=0.619
+el: name=N ; f=0.017
+el: name=O ; f=0.251
+el: name=P ; f=0.001

# ---- system ------------------------------------------------------------------------------------------------------------
# Carbon-fibre composite: breast support, detector cover, grid covers and interspace [A] (thickness not documented).
CarbonFibre: d=1.55 g/cm3 ; n=3 ; state=solid
+el: name=C ; f=0.85
+el: name=H ; f=0.05
+el: name=O ; f=0.10

# Amorphous selenium (detector; used by the analytic detector model only, not placed in the GATE geometry).
aSe: d=4.27 g/cm3 ; n=1 ; state=solid
+el: name=Se ; f=1.0

# ==== iodine discs: PMMA + iodine, one material per row. Generated by:  python materials.py --iodine 1.2 0.9 0.7 0.4 0.27 0.17 0.1 ====
# Each row: the areal density (mg I/cm2) spread over the 3.0 mm plate thickness, mixed into PMMA (mixture rule). Values [A]:
# lower-bound estimates from the July 2026 plate images (REPORT §13.2); replace with the nominal values.
# row 0: 1.2 mg I/cm2 = 4.000 mg I/cm3
PMMA_I_row0: d=1.194000 g/cm3 ; n=2 ; state=solid
+mat: name=G4_PLEXIGLASS ; f=0.9966499
+el: name=I ; f=0.0033501
# row 1: 0.9 mg I/cm2 = 3.000 mg I/cm3
PMMA_I_row1: d=1.193000 g/cm3 ; n=2 ; state=solid
+mat: name=G4_PLEXIGLASS ; f=0.9974853
+el: name=I ; f=0.0025147
# row 2: 0.7 mg I/cm2 = 2.333 mg I/cm3
PMMA_I_row2: d=1.192333 g/cm3 ; n=2 ; state=solid
+mat: name=G4_PLEXIGLASS ; f=0.9980431
+el: name=I ; f=0.0019569
# row 3: 0.4 mg I/cm2 = 1.333 mg I/cm3
PMMA_I_row3: d=1.191333 g/cm3 ; n=2 ; state=solid
+mat: name=G4_PLEXIGLASS ; f=0.9988808
+el: name=I ; f=0.0011192
# row 4: 0.27 mg I/cm2 = 0.900 mg I/cm3
PMMA_I_row4: d=1.190900 g/cm3 ; n=2 ; state=solid
+mat: name=G4_PLEXIGLASS ; f=0.9992443
+el: name=I ; f=0.0007557
# row 5: 0.17 mg I/cm2 = 0.567 mg I/cm3
PMMA_I_row5: d=1.190567 g/cm3 ; n=2 ; state=solid
+mat: name=G4_PLEXIGLASS ; f=0.9995240
+el: name=I ; f=0.0004760
# row 6: 0.1 mg I/cm2 = 0.333 mg I/cm3
PMMA_I_row6: d=1.190333 g/cm3 ; n=2 ; state=solid
+mat: name=G4_PLEXIGLASS ; f=0.9997200
+el: name=I ; f=0.0002800

# ==== iodine discs (L2): PMMA + iodine, one material per row. Generated by:  python materials.py --phantom L2 --iodine 1.2 0.9 0.7 0.4 0.27 0.17 0.1 ====
# Each row: the areal density (mg I/cm2) spread over the 2.0 mm plate thickness, mixed into PMMA (mixture rule). Values [A]:
# lower-bound estimates from the July 2026 plate images (REPORT §13.2); replace with the nominal values.
# row 0: 1.2 mg I/cm2 = 6.000 mg I/cm3
PMMA_I_L2_row0: d=1.196000 g/cm3 ; n=2 ; state=solid
+mat: name=G4_PLEXIGLASS ; f=0.9949833
+el: name=I ; f=0.0050167
# row 1: 0.9 mg I/cm2 = 4.500 mg I/cm3
PMMA_I_L2_row1: d=1.194500 g/cm3 ; n=2 ; state=solid
+mat: name=G4_PLEXIGLASS ; f=0.9962327
+el: name=I ; f=0.0037673
# row 2: 0.7 mg I/cm2 = 3.500 mg I/cm3
PMMA_I_L2_row2: d=1.193500 g/cm3 ; n=2 ; state=solid
+mat: name=G4_PLEXIGLASS ; f=0.9970674
+el: name=I ; f=0.0029326
# row 3: 0.4 mg I/cm2 = 2.000 mg I/cm3
PMMA_I_L2_row3: d=1.192000 g/cm3 ; n=2 ; state=solid
+mat: name=G4_PLEXIGLASS ; f=0.9983221
+el: name=I ; f=0.0016779
# row 4: 0.27 mg I/cm2 = 1.350 mg I/cm3
PMMA_I_L2_row4: d=1.191350 g/cm3 ; n=2 ; state=solid
+mat: name=G4_PLEXIGLASS ; f=0.9988668
+el: name=I ; f=0.0011332
# row 5: 0.17 mg I/cm2 = 0.850 mg I/cm3
PMMA_I_L2_row5: d=1.190850 g/cm3 ; n=2 ; state=solid
+mat: name=G4_PLEXIGLASS ; f=0.9992862
+el: name=I ; f=0.0007138
# row 6: 0.1 mg I/cm2 = 0.500 mg I/cm3
PMMA_I_L2_row6: d=1.190500 g/cm3 ; n=2 ; state=solid
+mat: name=G4_PLEXIGLASS ; f=0.9995800
+el: name=I ; f=0.0004200
