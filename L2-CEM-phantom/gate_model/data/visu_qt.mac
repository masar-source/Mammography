# Geant4 Qt viewer (OpenGL) for:  python revelation_gate.py --visu qt
# One Geant4 command per line; lines starting with '#' and empty lines are ignored. Edit freely.
# In the window: drag to rotate, scroll to zoom; the command line at the bottom accepts the same commands.
/vis/open OGLIQt
/vis/drawVolume worlds
# hide the world box (the absorber below the detector plane is hidden through its colour)
/vis/geometry/set/visibility world 0 false
/vis/viewer/set/style surface
/vis/ogl/set/transparency true
# no facet edges: the container meshes have ~120 000 facets each
/vis/viewer/set/auxiliaryEdge false
/vis/viewer/set/lineSegmentsPerCircle 24
# z up, looking at the phantom from the front-left and slightly above
/vis/viewer/set/upVector 0 0 1
/vis/viewer/set/viewpointThetaPhi 70 -60 deg
/vis/viewer/set/targetPoint 80 0 40 mm
/vis/viewer/zoomTo 4
/vis/scene/add/axes 0 0 0 50 mm
# photon tracks (gamma yellow, electrons red), accumulated over the run
/vis/modeling/trajectories/create/drawByParticleID
/vis/modeling/trajectories/drawByParticleID-0/set gamma yellow
/vis/modeling/trajectories/drawByParticleID-0/set e- red
/tracking/storeTrajectory 1
/vis/scene/add/trajectories
/vis/scene/endOfEventAction accumulate 10000
/vis/viewer/flush
